# Documentation only. Copy to .env for Compose; PHP does not load dotenv files.
# Development defaults without .env are local kvazi/kvazi, never production secrets.
APP_ENV=development

DB_HOST=db
DB_PORT=5432
DB_NAME=kvazi
DB_USER=kvazi
DB_PASSWORD=change-me

# Set to 1 for HTTPS behind a TLS-terminating proxy.
AUTH_COOKIE_SECURE=0

# Comma-separated IPv4/IPv6 CIDRs of the immediate PHP reverse proxy.
# Empty trusts nobody. Configure actual narrowly scoped CIDRs at deployment.
# Trusted proxy may forward one validated CF-Connecting-IP; XFF is ignored.
TRUSTED_PROXY_CIDRS=
